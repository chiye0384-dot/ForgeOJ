# Copy this file to .env before starting the M0 local infrastructure.
# Replace every example secret locally; never commit the resulting .env file.
MYSQL_ROOT_PASSWORD=replace-with-local-root-secret
FORGEOJ_MIGRATOR_PASSWORD=replace-with-local-migrator-secret
FORGEOJ_API_DB_PASSWORD=replace-with-local-api-secret
FORGEOJ_WORKER_DB_PASSWORD=replace-with-local-worker-secret
MYSQL_PORT=3306
RABBITMQ_DEFAULT_USER=forgeoj
RABBITMQ_DEFAULT_PASS=replace-with-local-rabbitmq-secret
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Account settings belong to the API process environment, not the infrastructure
# Compose services. Compose does not automatically export this file to the API.
# Leave empty only for dev's temporary key; a non-dev API fails startup without
# at least 32 bytes of private random signing material. Never use the test key.
FORGEOJ_AUTH_JWT_SECRET=
# Independent administrator signing key; never reuse the ordinary-account key.
# Non-dev startup requires at least 32 UTF-8 bytes. Dev may generate a temporary key.
FORGEOJ_ADMIN_JWT_SECRET=
# Keep true for HTTPS deployment; false is only for isolated local HTTP dev/test.
FORGEOJ_ADMIN_COOKIE_SECURE=true
# Production defaults: FORGEOJ_AUTH_COOKIE_SECURE=true and
# FORGEOJ_AUTH_MAIL_MODE=disabled. The dev profile selects HTTP cookies and the
# loopback mailbox at 127.0.0.1:2525 unless FORGEOJ_AUTH_MAIL_MODE is explicitly
# exported. Set it to smtp when testing SMTP; do not expose the local mailbox.
# SMTP connects only when mode=smtp and an eligible account action sends mail.
FORGEOJ_AUTH_MAIL_MODE=disabled
FORGEOJ_AUTH_MAIL_APP_URL=http://localhost:5173
# Set a verified provider host/from and HTTPS frontend URL in the API environment.
# starttls requires STARTTLS; implicit requires TLS from the first byte (usually 465).
FORGEOJ_AUTH_MAIL_SMTP_HOST=
FORGEOJ_AUTH_MAIL_SMTP_PORT=587
FORGEOJ_AUTH_MAIL_SMTP_TLS=starttls
FORGEOJ_AUTH_MAIL_SMTP_FROM=
FORGEOJ_AUTH_MAIL_SMTP_USERNAME=
FORGEOJ_AUTH_MAIL_SMTP_PASSWORD=
FORGEOJ_AUTH_MAIL_SMTP_CONNECT_TIMEOUT_MS=5000
FORGEOJ_AUTH_MAIL_SMTP_READ_TIMEOUT_MS=5000
FORGEOJ_AUTH_MAIL_SMTP_WRITE_TIMEOUT_MS=5000
