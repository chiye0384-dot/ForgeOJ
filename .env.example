# Copy this file to .env before starting the M0 local infrastructure.
# Replace every example secret locally; never commit the resulting .env file.
MYSQL_ROOT_PASSWORD=replace-with-local-root-secret
FORGEOJ_MIGRATOR_PASSWORD=replace-with-local-migrator-secret
FORGEOJ_API_DB_PASSWORD=replace-with-local-api-secret
FORGEOJ_WORKER_DB_PASSWORD=replace-with-local-worker-secret
MYSQL_PORT=3306
RABBITMQ_DEFAULT_USER=forgeoj
RABBITMQ_DEFAULT_PASS=replace-with-local-rabbitmq-secret
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Account settings belong to the API process environment, not the infrastructure
# Compose services. Compose does not automatically export this file to the API.
# Leave empty only for dev's temporary key; a non-dev API fails startup without
# at least 32 bytes of private random signing material. Never use the test key.
FORGEOJ_AUTH_JWT_SECRET=
# Production defaults: FORGEOJ_AUTH_COOKIE_SECURE=true and
# FORGEOJ_AUTH_MAIL_MODE=disabled. The dev profile selects HTTP cookies and the
# loopback mailbox at 127.0.0.1:2525; no real SMTP adapter is included.
# If the frontend URL differs, export FORGEOJ_AUTH_MAIL_APP_URL in the API process.
