{
  "uid": "forgeoj-overview",
  "title": "ForgeOJ 最小监控",
  "tags": [
    "ForgeOJ",
    "M4"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "服务抓取成功（1=成功）",
      "type": "stat",
      "description": "抓取成功不等于业务就绪。基础设施端口仅在私有网络。",
      "datasource": {
        "type": "prometheus",
        "uid": "forgeoj-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} {{instance}} {{kind}} {{state}} {{event}} {{verdict}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "forgeoj-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "快照新鲜与Worker消费者",
      "type": "stat",
      "description": "SQL/消费者每15秒观测；45秒陈旧、失败显示0。Rabbit连接检测有心跳延迟。",
      "datasource": {
        "type": "prometheus",
        "uid": "forgeoj-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "forgeoj_monitoring_snapshot_fresh",
          "legendFormat": "{{job}} {{instance}} {{kind}} {{state}} {{event}} {{verdict}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "forgeoj-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "forgeoj_worker_consumers_ready",
          "legendFormat": "{{job}} {{instance}} {{kind}} {{state}} {{event}} {{verdict}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "forgeoj-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "请求速率（实测，非容量结论）",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "forgeoj-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route,status_class) (rate(forgeoj_http_requests_total[2m]))",
          "legendFormat": "{{job}} {{instance}} {{kind}} {{state}} {{event}} {{verdict}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "forgeoj-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "请求延迟分位数（固定桶估计）",
      "type": "timeseries",
      "description": "仅本次流量的桶估计，不构成P95性能提升或SLA声明。无请求时可能无数据。",
      "datasource": {
        "type": "prometheus",
        "uid": "forgeoj-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,route) (rate(forgeoj_http_request_duration_seconds_bucket[2m])))",
          "legendFormat": "{{job}} {{instance}} {{kind}} {{state}} {{event}} {{verdict}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "forgeoj-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
