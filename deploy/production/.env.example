# Non-secret settings only. Copy to instance.env outside the package.
COMPOSE_PROJECT_NAME=forgeoj-prod
FORGEOJ_DOMAIN=oj.example.invalid
FORGEOJ_HTTPS_PORT=443
FORGEOJ_HTTPS_SUFFIX=
FORGEOJ_HTTP_PORT=80
FORGEOJ_BIND_IP=127.0.0.1
# Local images must be pinned to their IDs after build; see build.sh.
FORGEOJ_API_IMAGE=
FORGEOJ_WORKER_IMAGE=
FORGEOJ_WEB_IMAGE=
FORGEOJ_PRIVATE_DIR=/srv/forgeoj-private
FORGEOJ_DOCKER_SOCKET_GID=
FORGEOJ_MAIL_MODE=disabled
FORGEOJ_SMTP_HOST=
FORGEOJ_SMTP_PORT=587
FORGEOJ_SMTP_TLS=starttls
FORGEOJ_SMTP_FROM=
FORGEOJ_SMTP_USERNAME=
